        "title": "JobEvent"
      },
      "JobListItem": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "project_name": {
            "type": "string",
            "title": "Project Name"
          },
          "bug_report": {
            "type": "string",
            "title": "Bug Report"
          },
