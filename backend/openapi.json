          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "has_nebius_config": {
            "type": "boolean",
            "title": "Has Nebius Config"
          }
        },
        "type": "object",
        "required": [
          "environment",
          "has_nebius_config"
        ],
        "title": "HealthResponse"
      },
