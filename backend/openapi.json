        "title": "CreateProjectResponse"
      },
      "DiffInfoSchema": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "unified_diff": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unified Diff"
          },
          "changed_files": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Changed Files"
          },
          "download_patch_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download Patch Url"
          },
          "download_zip_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Download Zip Url"
          }
        },
        "type": "object",
        "required": [
          "available",
          "unified_diff",
          "changed_files",
          "download_patch_url",
          "download_zip_url"
