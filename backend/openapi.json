            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FinalVerdict"
              },
