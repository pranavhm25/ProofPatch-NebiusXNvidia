            "type": "string",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "progress_percent": {
            "type": "integer",
