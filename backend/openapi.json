        "title": "DiffInfoSchema"
      },
      "FinalVerdict": {
        "type": "string",
        "enum": [
          "VERIFIED",
          "NOT_VERIFIED",
          "FAILED",
          "BLOCKED"
        ],
        "title": "FinalVerdict"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
