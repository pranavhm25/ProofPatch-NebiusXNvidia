# ProofPatch — Environment Configuration Template
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# All secrets are server-side only and must never be exposed in browser assets.

# ─── Nebius Token Factory ─────────────────────────────────────────────────────
# Obtain from your Nebius AI Cloud console → Token Factory section.
NEBIUS_API_KEY=

# Official Nebius API base URL (OpenAI-compatible endpoint).
# Verify against the current Nebius documentation before use.
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Exact model identifier verified against the account's Token Factory catalog.
# Example (verify actual availability): nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_MODEL=

# ─── Execution Sandbox ────────────────────────────────────────────────────────
# Identifier for the sandbox implementation used to run pytest.
# Supported values: "local_process" (isolated subprocess, no Docker required)
#                   "nebius_sandbox" (if Token Factory sandbox API is available)
SANDBOX_PROVIDER=local_process

# ─── Upload / Archive Limits ─────────────────────────────────────────────────
MAX_UPLOAD_BYTES=20971520          # 20 MB compressed upload limit
MAX_EXTRACTED_BYTES=104857600      # 100 MB maximum extracted workspace
MAX_ARCHIVE_FILES=500              # Maximum number of archive entries
MAX_FILE_BYTES=524288              # 512 KB maximum per file for model context

# ─── Patch Limits ─────────────────────────────────────────────────────────────
MAX_PATCH_BYTES=102400             # 100 KB maximum generated patch
MAX_CHANGED_FILES=10               # Maximum files a single patch may touch

# ─── Repair Loop ─────────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=2              # 1 initial attempt + 1 retry maximum

# ─── Timeouts ─────────────────────────────────────────────────────────────────
JOB_TIMEOUT_SECONDS=300            # Total job deadline (5 minutes)
SANDBOX_TIMEOUT_SECONDS=60         # Per-test-run execution deadline
PROVIDER_TIMEOUT_SECONDS=60        # Nebius inference call timeout

# ─── Output Limits ───────────────────────────────────────────────────────────
MAX_LOG_BYTES=51200                # 50 KB maximum stored test output

# ─── Retention ────────────────────────────────────────────────────────────────
RETENTION_MINUTES=60               # Source/workspace expiry after job ends

# ─── Server ───────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins for CORS.
# In development: http://localhost:5173
# In production: your deployed frontend origin.
CORS_ORIGINS=http://localhost:5173

APP_ENV=development                # development | test | production

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
